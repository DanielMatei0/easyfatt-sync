{
  "name": "easyfatt-sync-app",
  "version": "1.0.2",
  "description": "Easyfatt Sync",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "dist:mac:intel": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --x64",
    "check": "node scripts/health-check.js",
    "security:check": "node scripts/security-check.js",
    "icons:win": "node scripts/generate-icon-ico.js",
    "icons:mac": "bash scripts/generate-icon-icns.sh"
  },
  "build": {
    "appId": "com.avenlabs.easyfattsync",
    "productName": "Easyfatt Sync",
    "copyright": "Copyright © Aven Labs",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!docs/**",
      "!docs-pdf/**",
      "!backend-examples/**",
      "!**/.DS_Store",
      "!**/.git/**",
      "!oauth_credentials.example.json",
      "!**/*.easyfatt-sync-backup.json",
      "!token.json",
      "!**/*.log"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Easyfatt-Sync-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Easyfatt Sync",
      "uninstallDisplayName": "Easyfatt Sync",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "Easyfatt-Sync-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "Easyfatt Sync"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DanielMatei0",
        "repo": "easyfatt-sync"
      }
    ]
  },
  "keywords": [],
  "author": "AvenLabs",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "googleapis": "^171.4.0",
    "node-cron": "^4.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}
